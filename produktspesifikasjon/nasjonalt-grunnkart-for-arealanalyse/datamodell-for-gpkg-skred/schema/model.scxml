          <sc:DescriptorValue>Gjentaksintervall: 100 år</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>36</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>1000</sc:name>
       <sc:id>C11_37</sc:id>
