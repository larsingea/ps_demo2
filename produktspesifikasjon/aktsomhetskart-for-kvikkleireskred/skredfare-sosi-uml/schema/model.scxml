          <sc:TaggedValue>
           <sc:name>SOSI_navn</sc:name>
           <sc:values>
            <sc:Value>SKREDSTATSANN</sc:Value>
           </sc:values>
          </sc:TaggedValue>
         </sc:taggedValues>
