       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>inndeling i administrative og politiske enheter innenfor fylket

Merknad: Tilsvarer NUTS 5 og LAU 2 på internasjonalt statistisk nivå</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
